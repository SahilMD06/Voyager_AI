# ---- LLM (required for the AI agent; without it the labelled rule-based
# ---- fallback planner is used) ------------------------------------------
# Provider: gemini | openai | groq
LLM_PROVIDER=gemini
# Optional model override (defaults: gemini-3.5-flash, gpt-4o-mini,
# llama-3.3-70b-versatile)
LLM_MODEL=
# Retried once if the main model fails (empty = provider default, "none" = off)
LLM_FALLBACK_MODEL=
# Optional; empty = provider default (recommended for Gemini 3)
LLM_TEMPERATURE=

# Set the key for the provider you chose
GOOGLE_API_KEY=
OPENAI_API_KEY=
# Optional: OpenAI-compatible endpoint (e.g. Azure/OpenRouter)
OPENAI_BASE_URL=
GROQ_API_KEY=

# ---- Open-Meteo needs no key ---------------------------------------------
HTTP_TIMEOUT_SECONDS=12
# Contact link Wikimedia requires for destination photos
HTTP_USER_AGENT=

# ---- Budget estimate assumptions (INR) -------------------------------------
FOOD_PER_PERSON_PER_DAY_BUDGET=700
FOOD_PER_PERSON_PER_DAY_MID=1200
FOOD_PER_PERSON_PER_DAY_LUXURY=2200
LOCAL_TRANSPORT_PER_VEHICLE_PER_DAY=900

# ---- Server ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
